APP_NAME=Wijhan
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (required) ---------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wijhan_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mail is sent through the queue so an outage never fails a lead's HTTP
# request. Run `php artisan queue:work` (or a supervisor process) for
# queued mail to actually be delivered.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (required for real delivery in production) ------------------------
# MAIL_MAILER=log writes emails to the log instead of sending them —
# fine for local development, but must be switched to smtp (or another
# real driver) before this goes to production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wijhan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where Contact / Quote Request team notifications are delivered.
WIJHAN_TEAM_EMAIL=hello@wijhan.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Frontend / CORS / Sanctum (required for production) -------------------
# Comma-separated list of origins allowed to call this API, e.g.
# FRONTEND_URL=https://wijhan.com,https://www.wijhan.com
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# --- Local admin seed credentials (required before `php artisan db:seed`) --
# Change these before seeding anything but a local/dev database.
ADMIN_SEED_EMAIL=admin@wijhan.com
ADMIN_SEED_PASSWORD=ChangeMe123!
MANAGER_SEED_EMAIL=manager@wijhan.com
MANAGER_SEED_PASSWORD=ChangeMe123!

# --- Production checklist ---------------------------------------------------
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://<api-domain>, a real
# FRONTEND_URL allowlist (no localhost), MAIL_MAILER=smtp, strong seed
# passwords. Redirect HTTP->HTTPS and set HSTS at the web server/proxy.
# Admin API token lifetime in minutes (default 720 = 12h).
SANCTUM_TOKEN_EXPIRATION=720
